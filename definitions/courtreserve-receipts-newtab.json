{
  "name": "CourtReserve receipts (new tab)",
  "url": "https://app.courtreserve.com/Online/MyBalance/Index/13140?page=details",
  "_readme": [
    "The alternative shape of definitions/courtreserve-receipts.json.",
    "",
    "Everything is the same except the receipt step. This file clicks the Receipt",
    "control and waits for the new tab that the click opens, then captures that",
    "tab and closes it with goBack. Use it when the discovery report shows that",
    "the Receipt control carries no usable href — that is, when it is a button or",
    "an anchor with href=\"javascript:void(0)\" and a click handler.",
    "",
    "Run it with:",
    "  npm run job:receipts -- --out ./exports/receipts --definition definitions/courtreserve-receipts-newtab.json",
    "",
    "EVERY SELECTOR IN THIS FILE IS AN UNVERIFIED KENDO UI 2022.1 DEFAULT.",
    "Confirm each one with `npm run discover` first. See docs/RECEIPTS.md."
  ],
  "_dates": {
    "start": "01/01/2020",
    "end": "12/31/2026",
    "_note": "These two values are copied into the two fill steps below. Change both places."
  },
  "config": {
    "auth": { "mode": "cdp", "endpointUrl": "http://localhost:9222" },
    "limits": {
      "maxDurationMs": 900000,
      "maxSteps": 10000,
      "maxPages": 500,
      "maxArtifacts": 2000
    },
    "steps": [
      { "op": "goto", "waitUntil": "load" },

      {
        "op": "click",
        "selector": ".k-tabstrip .k-item > .k-link:has-text('Payments')",
        "optional": true,
        "timeoutMs": 15000
      },

      { "op": "fill", "selector": "#StartDate", "value": "01/01/2020" },
      { "op": "fill", "selector": "#EndDate", "value": "12/31/2026" },
      { "op": "press", "key": "Enter" },

      {
        "op": "waitFor",
        "selector": ".k-grid .k-grid-content tbody tr.k-master-row",
        "state": "visible",
        "timeoutMs": 20000
      },

      {
        "op": "paginate",
        "nextSelector": ".k-pager-wrap a.k-pager-nav[title=\"Go to the next page\"]",
        "maxPages": 50,
        "steps": [
          {
            "op": "forEach",
            "rowSelector": ".k-grid .k-grid-content tbody tr.k-master-row",
            "steps": [
              {
                "op": "extract",
                "name": "receipts",
                "emit": ["JSON", "CSV"],
                "fields": [
                  { "name": "date", "selector": "td:nth-child(1)" },
                  { "name": "amount", "selector": "td:nth-child(2)" },
                  { "name": "paidDate", "selector": "td:nth-child(3)" },
                  { "name": "paymentType", "selector": "td:nth-child(4)" }
                ]
              },
              {
                "op": "click",
                "selector": "a.k-button",
                "opens": "newTab",
                "timeoutMs": 20000
              },
              {
                "op": "capture",
                "as": ["PNG", "PDF"],
                "name": "receipt-{{page}}-{{index}}-{{row.date}}",
                "fullPage": true
              },
              { "op": "goBack" }
            ]
          }
        ]
      }
    ]
  }
}

# -----------------------------------------------------------------------------
# Local (non-Docker) development: services read these directly.
# For `docker compose`, the compose file wires services to each other by service
# name (postgres/redis/minio) and only interpolates the credentials/ports below.
# -----------------------------------------------------------------------------

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scraper

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=scraper-artifacts
MINIO_USE_SSL=false

# Service ports
API_PORT=4000
WEB_PORT=3000

# Browser origins the API accepts, comma separated. The web UI posts from here.
CORS_ORIGINS=http://localhost:3000

# Scheduler / worker tuning
SCHEDULER_INTERVAL_MS=10000
WORKER_CONCURRENCY=4

# Frontend
# Server-side rendering (inside the web container) uses API_BASE_URL to reach the
# api service over the Docker network.
API_BASE_URL=http://localhost:4000
# Baked into the browser bundle at build time; must be reachable from the host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# docker compose interpolation (optional overrides; sensible defaults applied).
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scraper
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_CONSOLE_PORT=9001

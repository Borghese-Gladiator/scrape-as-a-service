# -----------------------------------------------------------------------------
# Local (non-Docker) development: services read these directly.
# For `docker compose`, the compose file wires services to each other by service
# name (postgres/redis/minio) and only interpolates the credentials/ports below.
# -----------------------------------------------------------------------------

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scraper

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=scraper-artifacts
MINIO_USE_SSL=false

# Service ports
API_PORT=4000
WEB_PORT=3000
# Health endpoints of the worker and the scheduler.
WORKER_HEALTH_PORT=4001
SCHEDULER_HEALTH_PORT=4002

# Browser origins the API accepts, comma separated. The web UI posts from here.
CORS_ORIGINS=http://localhost:3000

# Scheduler / worker tuning
SCHEDULER_INTERVAL_MS=10000
WORKER_CONCURRENCY=4
# Hard limit on one scrape. The worker fails the run with the code TIMEOUT.
RUN_TIMEOUT_MS=120000
# The scheduler fails a RUNNING attempt that stops its heartbeat for this long.
STALE_ATTEMPT_MINUTES=10

# Logging
# One of: trace, debug, info, warn, error, fatal, silent.
# Output is pretty-printed unless NODE_ENV=production.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Every route except /health needs this value in the X-API-Key header. An empty
# value runs the API open and prints a warning; with NODE_ENV=production an
# empty value stops the API from starting.
#   openssl rand -base64 32
API_KEY=

# The key that encrypts every stored secret (AES-256-GCM). It must decode to
# exactly 32 bytes from base64 or from hex. The api and the worker need it; the
# scheduler does not. Lose it and every stored secret is unreadable.
#   openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# Let the platform fetch a loopback, private or link-local URL. Leave it off
# unless you scrape a local fixture site.
ALLOW_PRIVATE_URLS=false

# Let auth.mode=cdp attach to a Chrome that the user already runs with
# --remote-debugging-port. It cannot reach the host from inside the Docker
# worker. Local worker only.
ALLOW_CDP=false

# Let auth.mode=chromeProfile copy the user's Chrome profile off the disk.
# Local worker only.
ALLOW_LOCAL_PROFILE=false

# Retention: the scheduler deletes runs older than this many days, the storage
# objects first and the rows second. 0 disables the sweeper.
RETENTION_DAYS=30

# Frontend
# Server-side rendering (inside the web container) uses API_BASE_URL to reach the
# api service over the Docker network.
API_BASE_URL=http://localhost:4000
# Baked into the browser bundle at build time; must be reachable from the host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# The browser cannot read API_KEY, so a browser call needs this copy. It is
# baked into the bundle and is visible to anybody who loads the page.
NEXT_PUBLIC_API_KEY=

# -----------------------------------------------------------------------------
# docker compose interpolation (optional overrides; sensible defaults applied).
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scraper
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_CONSOLE_PORT=9001
